# PayPal Sandbox REST API Credentials
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal Sandbox Personal Account Email (Default Vendor Payout Recipient)
# PayGuard fails closed if this or per-vendor email is missing/blank.
PAYPAL_PAYOUT_RECIPIENT_EMAIL=your_sandbox_personal_recipient_email_here

# Optional Per-Vendor Dedicated Sandbox Personal Account Emails (or configure via local seed.json)
PAYPAL_PAYOUT_EMAIL_AWS_DEMO=your_sandbox_aws_demo_recipient_email_here
PAYPAL_PAYOUT_EMAIL_GITHUB_DEMO=your_sandbox_github_demo_recipient_email_here

# Cryptographic Key Separation (Ed25519)
# 1. Admin Mandate Verification (Public Key pinned in Gateway; Private Key kept offline by Admin)
PAYGUARD_ADMIN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----"

# 2. Gateway Receipt Signing (Private Key provisioned strictly to the Gateway runtime)
PAYGUARD_GATEWAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEI...\n-----END PRIVATE KEY-----"

# Neon Postgres Persistence (Item C)
# In production (NODE_ENV=production), DATABASE_URL is strictly required. Startup fails closed if missing.
# Offline deterministic tests default to in-memory adapter unless DATABASE_URL is explicitly set.
DATABASE_URL="postgresql://your_db_owner:your_neon_password@ep-your-pooler.region.aws.neon.tech/neondb?sslmode=require"
